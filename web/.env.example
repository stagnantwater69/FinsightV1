VITE_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
VITE_SUPABASE_ANON_KEY="[anon-key]"
# Keep API requests on the page's origin so localhost, LAN and shared tunnels
# all use Vite's /api proxy to the backend running on port 4000.
VITE_API_BASE_URL="/api/v1"

# If your public tunnel hostname changes, add its exact hostname to
# server.allowedHosts in vite.config.ts, or start Vite with a shell variable:
# __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS="your-tunnel-hostname" npm run dev
# Forward port 5173; API requests travel through that same forwarded port.
