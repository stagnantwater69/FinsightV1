{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "lint": "oxlint --max-warnings=40",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:built": "playwright test --config playwright.built.config.ts",
    "test:e2e:cross-browser": "playwright test --config playwright.cross-browser.config.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@sentry/browser": "^11.16.0",
    "@supabase/supabase-js": "^2.119.2",
    "axios": "^1.21.1",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
