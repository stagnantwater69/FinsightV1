# Test environment. Points at a THROWAWAY local Postgres container, never at
# the Supabase project — the integration tests truncate every table between
# test files, which would destroy real development data.
#
# Start the container with:  npm run test:db:up
#
# The Supabase values below are deliberately fake. Nothing in the test suite
# should reach Supabase: Storage and the Auth admin API are mocked, and the AI
# providers are never called (no API keys). If a test ever does make a real
# Supabase call it will fail loudly on these dummy values, which is the
# intended behaviour — that's a test that needs mocking, not real credentials.
DATABASE_URL="postgresql://testuser:testpass@localhost:55432/finsight_test"
DIRECT_URL="postgresql://testuser:testpass@localhost:55432/finsight_test"
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY="test-anon-key-not-real"
SUPABASE_SERVICE_ROLE_KEY="test-service-role-key-not-real"
SUPABASE_STORAGE_BUCKET="receipts"
NODE_ENV="test"
PORT="4999"
GOOGLE_GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
TESSERACT_LANG="eng"
