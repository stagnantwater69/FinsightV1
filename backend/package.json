{
  "name": "finsight-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "vitest --config vitest.config.mts run",
    "test:watch": "vitest --config vitest.config.mts",
    "test:unit": "vitest --config vitest.config.mts run tests/unit",
    "test:integration": "vitest --config vitest.config.mts run tests/integration",
    "test:db:up": "docker run -d --name finsight-test-db -e POSTGRES_PASSWORD=testpass -e POSTGRES_USER=testuser -e POSTGRES_DB=finsight_test -p 55432:5432 postgres:16-alpine",
    "test:db:down": "docker rm -f finsight-test-db",
    "test:db:reset": "npm run test:db:down --silent || true && npm run test:db:up"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@supabase/supabase-js": "^2.47.10",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "8.3.0",
    "multer": "^2.2.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.78.0",
    "prisma": "^6.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "tesseract.js@7.0.0": true,
    "esbuild@0.21.5": true
  }
}
