# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# How many reverse proxies sit in front of this process. This is a HOP COUNT,
# not a boolean: 0 when Node is the public edge (plain `npm run dev`), 1 behind
# the nginx in docker-compose. Every IP-keyed rate limit depends on it, so
# NODE_ENV=production refuses to start until it is set explicitly — a wrong
# value silently makes the auth limits either global or evadable.
TRUST_PROXY_HOPS=0

# Guards the DETAILED half of /api/v1/health/ready — queue depths and the
# stalled-deletion count. The plain ready/not-ready verdict stays public,
# because that is what a load balancer needs; the numbers are an operational
# readout and are not. Send it as an `x-health-token` header.
#
# Only enforced when NODE_ENV=production, and unset there means the numbers are
# never returned — a forgotten variable fails closed. Outside production the
# detail is always returned, so local development needs nothing here.
HEALTH_DETAIL_TOKEN=

# Where the clients live, used to build the links in verification and
# password-reset emails. Both must ALSO be listed in the Supabase dashboard
# under Authentication → URL Configuration → Redirect URLs, or Supabase will
# drop the redirect and send the user to the Site URL instead.
WEB_APP_URL=http://localhost:5173
MOBILE_APP_URL=finsight://

# Database — Supabase Postgres
# Transaction-mode pooler (used by the running app, IPv4-only, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true"
# Session-mode pooler (used only for running Prisma migrations, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@[POOLER_HOST]:5432/postgres"

# Supabase project
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"
SUPABASE_STORAGE_BUCKET="receipts"

# AI (Module 6 — not wired up yet, see ai.service.ts)
GOOGLE_GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Veryfi credentials remain usable by the explicit benchmark spike. They do
# not authorize production receipt dispatch; only the unified gate below can.
VERYFI_CLIENT_ID=""
VERYFI_CLIENT_SECRET=""
VERYFI_USERNAME=""
VERYFI_API_KEY=""

# Unified receipt-provider gate. These defaults make zero calls even when
# provider credentials are present. Phase 1 supports one selected provider,
# never a paid-provider cascade. Do not enable this block until its benchmark,
# consent, calibration, atomic budget, and kill-switch gates are all proven.
RECEIPT_PROVIDER_DISPATCH_ENABLED="false"
RECEIPT_PROVIDER_KILL_SWITCH="true"
# Enable only after the selected provider/version/region terms are reviewed.
RECEIPT_PROVIDER_DATA_TERMS_APPROVED="false"
RECEIPT_PROVIDER=
RECEIPT_PROVIDER_VERSION=
RECEIPT_PROVIDER_REGION=
RECEIPT_PROVIDER_RETENTION_HOURS=
RECEIPT_PROVIDER_ROUTING_CALIBRATED="false"
RECEIPT_PROVIDER_CALIBRATION_VERSION=
# Phase 1 hard-caps both resource and optional per-business limits at 100.
# Values are 0..100; unset or 0 disables dispatch rather than allowing overage.
RECEIPT_PROVIDER_MONTHLY_UNIT_LIMIT="0"
RECEIPT_PROVIDER_BUSINESS_MONTHLY_UNIT_LIMIT=

# OCR
TESSERACT_LANG="eng"
# The production image sets this to its root-owned, read-only language bundle.
# Leave unset for direct npm development; env.ts resolves the tracked backend
# language bundle. Set an absolute directory only for a custom local bundle.
# TESSERACT_LANG_PATH="/absolute/path/to/tessdata"

# Receipt request files use a private per-request directory below this root.
# Leave unset for direct npm development to use the OS temp directory. Docker
# sets a bounded, non-public tmpfs path explicitly. A custom path must end in
# finsight-receipt-uploads or finsight/receipt-uploads.
# RECEIPT_UPLOAD_TEMP_ROOT="/absolute/private/finsight-receipt-uploads"

# Docker sets /run/finsight/worker-health as a private tmpfs for worker PID and
# heartbeat markers. Standalone containers may use /tmp/finsight-worker-health;
# arbitrary paths are rejected before marker cleanup.
# RECEIPT_WORKER_HEALTH_DIR="/run/finsight/worker-health"
RECEIPT_WORKER_HEARTBEAT_MAX_AGE_SECONDS="45"

# Operator-only threshold for `npm run ops:receipt-queue:readiness`. This does
# not change queue leasing or retry behavior.
RECEIPT_QUEUE_STALE_AFTER_SECONDS="300"

# Anomaly detectors — staged off until shadow-mode results are reviewed
ANOMALY_NEAR_DUPLICATE_ENABLED="false"
ANOMALY_VELOCITY_ENABLED="false"
ANOMALY_TRENDS_ENABLED="false"
ANOMALY_BEHAVIORAL_NOVELTY_ENABLED="false"
# Recurring-expense schedule watching. Same staging rule as the four above, but
# note it is not findings-only: enabling it also sends owner notifications
# ("X is due <date> and has not been recorded yet"). See docs/deployment-runbook.md §3.
ANOMALY_RECURRING_ENABLED="false"
# Isolation Forest ML detector — SHADOW MODE ONLY. Enabling this persists
# evaluation findings the owner never sees; it also requires the Python
# scoring sidecar (ml/worker/server.py) reachable at ML_WORKER_URL. If the
# worker is down, analysis completes on the deterministic detectors.
ANOMALY_ISOLATION_FOREST_ENABLED="false"
ML_WORKER_URL="http://127.0.0.1:8321"
