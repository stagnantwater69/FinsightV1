# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# How many reverse proxies sit in front of this process. This is a HOP COUNT,
# not a boolean: 0 when Node is the public edge (plain `npm run dev`), 1 behind
# the nginx in docker-compose. Every IP-keyed rate limit depends on it, so
# NODE_ENV=production refuses to start until it is set explicitly — a wrong
# value silently makes the auth limits either global or evadable.
TRUST_PROXY_HOPS=0

# Guards the DETAILED half of /api/v1/health/ready — queue depths and the
# stalled-deletion count. The plain ready/not-ready verdict stays public,
# because that is what a load balancer needs; the numbers are an operational
# readout and are not. Send it as an `x-health-token` header.
#
# Only enforced when NODE_ENV=production, and unset there means the numbers are
# never returned — a forgotten variable fails closed. Outside production the
# detail is always returned, so local development needs nothing here.
HEALTH_DETAIL_TOKEN=

# Sentry project DSN for crash and server-error reports from the API and
# worker. Empty sends nothing anywhere. Reports carry the error, its stack and
# the request's method, route and id; request bodies, headers, users and
# emails are stripped before sending (src/lib/errorScrub.ts).
SENTRY_DSN=

# Daily ceilings on billed calls across ALL owners together (AI answers,
# category suggestions, receipt scans). Reaching one refuses that kind of call
# for everyone until the 24-hour window resets, and reports to Sentry. Size
# them from what you are willing to spend in a day. Unset uses the defaults.
SHARED_DAILY_AI_ANSWERS=5000
SHARED_DAILY_CATEGORY_SUGGESTIONS=30000
SHARED_DAILY_RECEIPT_SCANS=3000

# Usage reports (Sentry, with the numeric user id only; nothing is refused).
# A shared budget warns once a day on reaching this share of its ceiling, and
# an owner reaching it on a daily cap in USAGE_ALERT_DAYS windows within that
# many days is reported as sustained use. Unset uses the defaults.
# USAGE_ALERT_SHARE=0.8
# USAGE_ALERT_DAYS=3

# Where the clients live, used to build the links in verification and
# password-reset emails. Both must ALSO be listed in the Supabase dashboard
# under Authentication → URL Configuration → Redirect URLs, or Supabase will
# drop the redirect and send the user to the Site URL instead.
WEB_APP_URL=http://localhost:5173
MOBILE_APP_URL=finsight://

# Database — Supabase Postgres
# Database TLS. Both URLs below must end with
#   sslmode=require&sslcert=<absolute path to the CA certificate>&sslaccept=strict
# or the API, the workers and `migrate` refuse to start. Prisma checks the
# certificate chain and the host name only with all three; without them it
# accepts any certificate, or none (backend/src/config/databaseTls.ts). Only a
# loopback host (localhost, 127.x, ::1) is exempt.
#   Provisioning: the CA is "Supabase Root 2021 CA", which the pooler's chain
#   (*.pooler.supabase.com <- Supabase Intermediate 2021 CA <- root) ends in.
#   Download it from Supabase Dashboard > Database > Settings > SSL
#   Configuration (prod-ca-2021.crt; Studio's source links it to
#   https://supabase-downloads.s3-ap-southeast-1.amazonaws.com/prod/ssl/prod-ca-2021.crt)
#   and check `openssl x509 -noout -subject
#   -fingerprint -sha256` shows that name and SHA256 80:70:25:AD:50:D4:ED:21:
#   9D:2C:9C:7D:29:9C:00:4F:82:4E:B0:0C:F7:F6:5A:FE:F6:07:D0:7B:72:E6:CA:FA
#   (valid to 2031-04-26; the root the ap-southeast-1 pooler chained to on
#   2026-11-27). Go by the fingerprint, not the name: Supabase's 2025 root
#   carries the same name (SHA256 5F:9B:77:95:…:2C:9A:E2) and this pooler does
#   not chain to it. Make the file readable by the container's `node` user
#   (chmod 644). Save it as
#   backend/certs/supabase-ca.crt on the VM (docker-compose.yml mounts
#   backend/certs at /app/certs). Outside Docker, set sslcert to the
#   file's absolute path. Write the path plainly: letters, digits, . _ - /
#   only, no %-escapes or "+" (Prisma decodes them, the shell scripts do not).
#   Then `bash deploy/deploy.sh --check`: it changes no data, settings or
#   running service, but it does build the `migrate` image, run short-lived
#   check containers and open read-only database connections.
#   The file must hold exactly one certificate: Prisma trusts only the first
#   one in a file, so a bundle is refused rather than half-used.
#   Renewal: the API refuses to start once the certificate has expired, and
#   connections fail (P1011) once the pooler moves to a different root, which
#   Supabase may do without notice. Then fetch the new root, check its
#   fingerprint, replace the file, run `bash deploy/deploy.sh --check`, then
#   redeploy; one file cannot hold both, so this cannot be prepared ahead.
#   backup-db.sh verifies with the same file (libpq, sslmode=verify-full).
#   In development only, `npm run dev` routes a pooler DATABASE_URL WITHOUT
#   these settings through a loopback TLS relay that cannot verify the
#   server (scripts/database-tls-relay.ts); with them it connects directly.
# Transaction-mode pooler (used by the running app, IPv4-only, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true&sslmode=require&sslcert=/app/certs/supabase-ca.crt&sslaccept=strict"
# Prisma connections per process. docker-compose.yml sets this per service
# (api 8, receipt worker 3, jobs worker 4); a connection_limit already in
# DATABASE_URL wins. Unset = Prisma's CPU-based default.
# DATABASE_POOL_SIZE=8
# The API touches this many pooled connections every 15 s so a pause does not
# cost a reconnect (about 600 ms per connection to the hosted database).
# Defaults to DATABASE_POOL_SIZE, capped at 10; 0 turns it off.
# DATABASE_KEEP_WARM_CONNECTIONS=8
# Session-mode pooler (used only for running Prisma migrations, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@[POOLER_HOST]:5432/postgres?sslmode=require&sslcert=/app/certs/supabase-ca.crt&sslaccept=strict"

# Supabase project
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"
SUPABASE_STORAGE_BUCKET="receipts"

# AI (Module 6 — not wired up yet, see ai.service.ts)
GOOGLE_GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
# Ask FinSight may spend one extra Gemini call per lookup-style question
# (rankings, filters, comparisons). Set to "false" if the quota runs short.
ASK_FINSIGHT_TOOLS_ENABLED="true"

# Veryfi credentials remain usable by the explicit benchmark spike. They do
# not authorize production receipt dispatch; only the unified gate below can.
VERYFI_CLIENT_ID=""
VERYFI_CLIENT_SECRET=""
VERYFI_USERNAME=""
VERYFI_API_KEY=""

# Unified receipt-provider gate. These defaults make zero calls even when
# provider credentials are present. Phase 1 supports one selected provider,
# never a paid-provider cascade. Do not enable this block until its benchmark,
# consent, calibration, atomic budget, and kill-switch gates are all proven.
RECEIPT_PROVIDER_DISPATCH_ENABLED="false"
RECEIPT_PROVIDER_KILL_SWITCH="true"
# Enable only after the selected provider/version/region terms are reviewed.
RECEIPT_PROVIDER_DATA_TERMS_APPROVED="false"
RECEIPT_PROVIDER=
RECEIPT_PROVIDER_VERSION=
RECEIPT_PROVIDER_REGION=
RECEIPT_PROVIDER_RETENTION_HOURS=
RECEIPT_PROVIDER_ROUTING_CALIBRATED="false"
RECEIPT_PROVIDER_CALIBRATION_VERSION=
# Phase 1 hard-caps both resource and optional per-business limits at 100.
# Values are 0..100; unset or 0 disables dispatch rather than allowing overage.
RECEIPT_PROVIDER_MONTHLY_UNIT_LIMIT="0"
RECEIPT_PROVIDER_BUSINESS_MONTHLY_UNIT_LIMIT=
# Opt-ins on top of an operational provider block. Both default to the Phase 2
# policy when unset or set to anything else.
#   rescue  (default) - Tesseract reads first; the provider only sees scans the
#                       local read could not settle.
#   always            - every scan goes to the provider after the local read;
#                       Tesseract stays the fallback when the provider is
#                       skipped, over budget, fails, or is rejected.
RECEIPT_PROVIDER_ROUTING="rescue"
#   explicit  (default) - each business profile needs an owner tap on the
#                         consent card before any dispatch.
#   automatic           - consent is granted by operator policy on the first
#                         dispatch for a profile; an owner revoke still wins.
RECEIPT_PROVIDER_CONSENT_MODE="explicit"

# OCR
TESSERACT_LANG="eng"
# The production image sets this to its root-owned, read-only language bundle.
# Leave unset for direct npm development; env.ts resolves the tracked backend
# language bundle. Set an absolute directory only for a custom local bundle.
# TESSERACT_LANG_PATH="/absolute/path/to/tessdata"

# Receipt request files use a private per-request directory below this root.
# Leave unset for direct npm development to use the OS temp directory. Docker
# sets a bounded, non-public tmpfs path explicitly. A custom path must end in
# finsight-receipt-uploads or finsight/receipt-uploads.
# RECEIPT_UPLOAD_TEMP_ROOT="/absolute/private/finsight-receipt-uploads"

# Docker sets a lane-specific private tmpfs below /run/finsight for worker PID
# and heartbeat markers. Standalone containers may use the default below;
# arbitrary paths are rejected before marker cleanup.
# RECEIPT_WORKER_HEALTH_DIR="/run/finsight/worker-health"
RECEIPT_WORKER_HEARTBEAT_MAX_AGE_SECONDS="45"

# Queue lanes owned by this process: receipt, csv, analysis, and maintenance.
# `all` preserves the one-process local default. A deployed worker can own one
# lane or an explicit comma-separated set. Docker Compose overrides this with
# separate receipt and jobs workers so unrelated long jobs cannot block each
# other. Unknown, empty, repeated, or mixed `all,...` values stop startup.
WORKER_LANES="all"

# Completed CSV imports keep their records and batch history, while the
# private source CSV expires after this many days. The maintenance worker
# enqueues Storage deletion through the durable purge queue. Range 30..365.
CSV_SOURCE_RETENTION_DAYS="90"

# How long each selected lane sleeps after a pass that claimed nothing. A lane
# that claimed a job runs again immediately without delaying other lanes. At
# the 1000 default, an `all` process invokes seven consumer/reconciliation
# entry points per idle cycle; replica count multiplies that database load.
# Raising the interval cuts idle polling and adds the same amount to worst-case
# pickup latency. Clamped to 250..60000; anything unparseable, empty or zero
# falls back to 1000 rather than refusing to boot.
RECEIPT_WORKER_IDLE_POLL_MS="1000"

# Operator-only threshold for `npm run ops:receipt-queue:readiness`. This does
# not change queue leasing or retry behavior.
RECEIPT_QUEUE_STALE_AFTER_SECONDS="300"

# Anomaly detectors — staged off until shadow-mode results are reviewed
ANOMALY_NEAR_DUPLICATE_ENABLED="false"
ANOMALY_VELOCITY_ENABLED="false"
ANOMALY_TRENDS_ENABLED="false"
ANOMALY_BEHAVIORAL_NOVELTY_ENABLED="false"
# Recurring-expense schedule watching. Same staging rule as the four above, but
# note it is not findings-only: enabling it also sends owner notifications
# ("X is due <date> and has not been recorded yet"). See docs/deployment-runbook.md §3.
ANOMALY_RECURRING_ENABLED="false"
# Isolation Forest ML detector — SHADOW MODE ONLY. Enabling this persists
# evaluation findings the owner never sees; it also requires the Python
# scoring sidecar (ml/worker/server.py) reachable at ML_WORKER_URL. If the
# worker is down, analysis completes on the deterministic detectors. Under
# Docker Compose the sidecar starts only with the `ml` profile
# (COMPOSE_PROFILES=ml in the .env next to docker-compose.yml).
ANOMALY_ISOLATION_FOREST_ENABLED="false"
ML_WORKER_URL="http://127.0.0.1:8321"
