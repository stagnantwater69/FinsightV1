# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# How many reverse proxies sit in front of this process. This is a HOP COUNT,
# not a boolean: 0 when Node is the public edge (plain `npm run dev`), 1 behind
# the nginx in docker-compose. Every IP-keyed rate limit depends on it, so
# NODE_ENV=production refuses to start until it is set explicitly — a wrong
# value silently makes the auth limits either global or evadable.
TRUST_PROXY_HOPS=0

# Guards the DETAILED half of /api/v1/health/ready — queue depths and the
# stalled-deletion count. The plain ready/not-ready verdict stays public,
# because that is what a load balancer needs; the numbers are an operational
# readout and are not. Send it as an `x-health-token` header.
#
# Only enforced when NODE_ENV=production, and unset there means the numbers are
# never returned — a forgotten variable fails closed. Outside production the
# detail is always returned, so local development needs nothing here.
HEALTH_DETAIL_TOKEN=

# Where the clients live, used to build the links in verification and
# password-reset emails. Both must ALSO be listed in the Supabase dashboard
# under Authentication → URL Configuration → Redirect URLs, or Supabase will
# drop the redirect and send the user to the Site URL instead.
WEB_APP_URL=http://localhost:5173
MOBILE_APP_URL=finsight://

# Database — Supabase Postgres
# Transaction-mode pooler (used by the running app, IPv4-only, port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true"
# Session-mode pooler (used only for running Prisma migrations, port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[URL_ENCODED_PASSWORD]@[POOLER_HOST]:5432/postgres"

# Supabase project
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"
SUPABASE_STORAGE_BUCKET="receipts"

# AI (Module 6 — not wired up yet, see ai.service.ts)
GOOGLE_GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Veryfi receipt-OCR API. Used by tests/ocr-accuracy/veryfi-spike.ts to
# benchmark against the deterministic tesseract pipeline, and — only when
# VERYFI_ENABLED=true — as a real production rescue ahead of the Gemini
# vision-rescue. Leave VERYFI_ENABLED=false to keep credentials configured
# without sending any real customer receipt to Veryfi.
VERYFI_CLIENT_ID=""
VERYFI_CLIENT_SECRET=""
VERYFI_USERNAME=""
VERYFI_API_KEY=""
VERYFI_ENABLED="false"
# Unset = no limit. A calendar-month request cap once VERYFI_ENABLED=true.
VERYFI_MONTHLY_LIMIT=

# OCR
TESSERACT_LANG="eng"

# Anomaly detectors — staged off until shadow-mode results are reviewed
ANOMALY_NEAR_DUPLICATE_ENABLED="false"
ANOMALY_VELOCITY_ENABLED="false"
ANOMALY_TRENDS_ENABLED="false"
ANOMALY_BEHAVIORAL_NOVELTY_ENABLED="false"
# Recurring-expense schedule watching. Same staging rule as the four above, but
# note it is not findings-only: enabling it also sends owner notifications
# ("X is due <date> and has not been recorded yet"). See docs/deployment-runbook.md §3.
ANOMALY_RECURRING_ENABLED="false"
# Isolation Forest ML detector — SHADOW MODE ONLY. Enabling this persists
# evaluation findings the owner never sees; it also requires the Python
# scoring sidecar (ml/worker/server.py) reachable at ML_WORKER_URL. If the
# worker is down, analysis completes on the deterministic detectors.
ANOMALY_ISOLATION_FOREST_ENABLED="false"
ML_WORKER_URL="http://127.0.0.1:8321"
