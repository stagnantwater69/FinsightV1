# Copy to mobile/.env and fill in.
#
# IMPORTANT for device testing: localhost means THE PHONE, not your computer.
# Use your machine's LAN address (e.g. http://192.168.1.14:4000/api/v1) so the
# device can actually reach the backend. An emulator on the same machine can
# use http://10.0.2.2:4000/api/v1 (Android's alias for the host).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1

# Same project as the web app. The anon/publishable key is client-visible by
# design; the service-role key must never appear here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Android only. Set false to hide the native ML Kit scanner and keep the
# existing FinSight camera/gallery flow.
EXPO_PUBLIC_RECEIPT_SCANNER_ENABLED=true
