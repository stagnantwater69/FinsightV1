# Copy to mobile/.env and fill in.
#
# IMPORTANT for device testing: localhost means THE PHONE, not your computer.
# Use your machine's LAN address (e.g. http://192.168.1.14:4000/api/v1) so the
# device can actually reach the backend. An emulator on the same machine can
# use http://10.0.2.2:4000/api/v1 (Android's alias for the host).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api/v1

# Same project as the web app. The anon/publishable key is client-visible by
# design; the service-role key must never appear here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Android only. Set false to hide the native ML Kit scanner and keep the
# existing FinSight camera/gallery flow.
EXPO_PUBLIC_RECEIPT_SCANNER_ENABLED=true

# The web app's public https origin (e.g. https://finsight.example.com).
# Confirmation emails land on ${WEB_APP_URL}/auth/confirm for every owner, and
# this is what lets the installed app claim that link instead of the browser
# (Android App Links / iOS Universal Links, see app.config.ts).
#
# LEAVE IT UNSET FOR LOCAL DEV. Anything that is not an https origin emits no
# association at all, which is deliberate: the claim only works if that host
# also serves /.well-known/assetlinks.json and apple-app-site-association, and
# a claim on a host that does not is worse than none. Confirmation still
# works without it — the website hands the session back over finsight://.
EXPO_PUBLIC_WEB_APP_URL=
